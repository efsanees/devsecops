# DevSecOps AI — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env

# ── Zorunlu ──────────────────────────────────────────────────────────────────

# Groq API anahtarı (pipeline YAML üretimi + LLM risk yorumu için)
# Ücretsiz key: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Opsiyonel ────────────────────────────────────────────────────────────────

# /auto-push endpoint'ini koruma altına alan API anahtarı
# Boş bırakılırsa endpoint açık kalır
API_KEY=

# Ek CORS origin'leri (virgülle ayır)
# Örnek: https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=

# SQLite veritabanı yolu (opsiyonel)
# Docker'da otomatik olarak docker-compose.yml tarafından set edilir.
# Yerel geliştirmede boş bırakılabilir — proje kökünde devsecops.db oluşturulur.
DATABASE_URL=

# ── Geliştirme notları ────────────────────────────────────────────────────────
#
# GitHub token: /analyze ve /job endpoint'lerine istek gövdesinde gönderilir,
# burada saklanmaz. Özel repo veya rate limit için kullanıcı kendi token'ını girer.
#
# Güvenlik tarayıcıları (Semgrep, Trivy, Gitleaks) Docker üzerinden çalışır.
# Docker Desktop açık olmalı. docker-compose.yml'de socket mount gerekli.
