# GitHub Actions Security Scanning - Environment Variables

# ============================================================================
# SonarQube Configuration
# ============================================================================
# Seriyi kopyala, .env dosyası oluştur ve değerleri doldur

# SonarQube Host URL
# Bulut: https://sonarcloud.io
# Kendi Server'ın: https://sonarqube.your-company.com
SONAR_HOST_URL=https://sonarcloud.io

# SonarQube Token
# Nasıl: My Account → Security → Generate Tokens
SONAR_TOKEN=your_sonarqube_token_here

# SonarQube Organization (SonarCloud için)
# Optional: opsiyonel GitHub'da secret olarak kullanılabilir
SONAR_ORG=your-org-name

# ============================================================================
# Snyk Configuration
# ============================================================================

# Snyk API Token
# Nasıl: https://app.snyk.io → Settings → API Token
SNYK_TOKEN=your_snyk_token_here

# ============================================================================
# GitHub Configuration
# ============================================================================

# GitHub Token (workflow'lar için)
# Not: GitHub otomatik olarak sağlıyor, elle eklemek gerekli değil
GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}

# ============================================================================
# Python Configuration
# ============================================================================

# Python version
PYTHON_VERSION=3.11

# ============================================================================
# Notification Configuration (İsteğe bağlı)
# ============================================================================

# Slack Webhook (Opsiyonel - PR'ler için notification)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Email (Opsiyonel)
ALERT_EMAIL=security-team@your-company.com

# ============================================================================
# Dosya Yolu Yapılandırması
# ============================================================================

# Kaynak kod klasörü
SOURCE_PATH=.

# Test klasörü
TEST_PATH=tests

# Dış klasörleri hariç tut
EXCLUDE_PATHS=venv,__pycache__,.venv,node_modules

# ============================================================================
# Kullanım Talimatları
# ============================================================================

# 1. Bu dosyayı .env olarak kaydet:
#    cp .env.example .env
#
# 2. Değerleri doldur (IDE'de görinmesini istemeyen)
#    NOT: .env dosyasını .gitignore'a ekle!
#
# 3. GitHub Secrets'e ekle:
#    Settings → Secrets and variables → Actions → New repository secret
#
# 4. Lokal test etmek için python-dotenv kullan:
#    pip install python-dotenv
#    from dotenv import load_dotenv
#    load_dotenv()
#    import os
#    token = os.getenv('SONAR_TOKEN')

# ============================================================================
# Dummy Values (Test İçin)
# ============================================================================

# Bunlar sadece örnek - gerçek değerler koy!
# SONAR_TOKEN=sqp_abcdef1234567890
# SNYK_TOKEN=sk-ab1234567890abcd1234567890
